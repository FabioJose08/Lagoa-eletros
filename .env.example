# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Firebase.
# Onde pegar: Console do Firebase > Configurações do projeto (engrenagem) > Geral > "Seus apps" > App da Web.
# NUNCA coloque chaves privadas aqui. Estes valores são públicos por natureza (a segurança vem das Security Rules).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ative apenas se você tiver Firebase Storage em projeto pago/funcional.
VITE_ENABLE_STORAGE_UPLOADS=false

# Opcional: mostra o botão "Entrar com Google" (ative o provedor Google em Authentication antes)
VITE_ENABLE_GOOGLE_LOGIN=false
